# ==============================================================================
#  wxscanless —— 微信多账号免扫码登录器
#  （项目/仓库代号 wxscanless；业务代码包名仍为 release\src\wxprof\）
#  版本库只跟踪：release\ + launcher.py（+ 本文件）
#  其余一律不入库，尤其是 data\（账号档案，含登录票据）
# ==============================================================================

# ---- 白名单：默认忽略一切，只放行下面这些 ----
/*
!/release/
!/release/**
!/launcher.py
!/.gitignore
!/.gitattributes

# ---- release\ 内部仍要排除的 ----
__pycache__/
*.py[cod]

# ==============================================================================
#  以下为显式黑名单（即便将来改用黑名单模式，也不会误入库）
# ==============================================================================

# 账号档案：登录票据 / host 路由 / key_info.db —— 绝不入库
data/

# PyInstaller 运行时（27MB / 986 文件，纯产物）
runtime/

# 运行日志
logs/
*.log

# 打包产物与二进制
*.exe
*.spec
build/
dist/
runtime.old.*
*.livebak

# 开发资产（诊断脚本 / 截图 / 打包工具 / 唯一文档）
_probe/
_tools/
_docs/

# 项目记忆
.workbuddy/

# 虚拟环境
.venv/

# 系统文件
Thumbs.db
desktop.ini
.DS_Store
